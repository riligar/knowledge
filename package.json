{
  "name": "@riligar/knowledge",
  "version": "1.10.0",
  "description": "A modern, open-source documentation platform that transforms how teams create, organize, and share knowledge.",
  "main": "index.ts",
  "type": "module",
  "bin": {
    "knowledge": "./bin/knowledge.js"
  },
  "files": [
    "bin/",
    "src/",
    "themes/",
    "index.ts",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riligar/knowledge.git"
  },
  "homepage": "https://myknowledge.click",
  "bugs": {
    "url": "https://github.com/riligar/knowledge/issues"
  },
  "scripts": {
    "build": "bun run src/cli.ts build",
    "dev": "bun run src/cli.ts dev",
    "serve": "bun run src/cli.ts serve",
    "start": "bun run index.ts",
    "knowledge": "bun run src/cli.ts",
    "build-bin": "bun build src/cli.ts --outdir bin --target node --format esm",
    "semantic-release": "semantic-release",
    "test-release": "./scripts/test-release.sh"
  },
  "keywords": [
    "documentation",
    "markdown",
    "static-site",
    "generator",
    "knowledge",
    "docs",
    "cli",
    "documentation-generator",
    "static-site-generator",
    "markdown-to-html"
  ],
  "author": {
    "name": "Ciro Cesar Maciel",
    "email": "maciel.ciro@icloud.com",
    "url": "https://riligar.click"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "chokidar": "^4.0.3",
    "commander": "^14.0.0",
    "fs-extra": "^11.3.0",
    "highlight.js": "^11.11.1",
    "lunr": "^2.3.9",
    "marked": "^15.0.12"
  },
  "devDependencies": {
    "@types/bun": "^1.2.15",
    "@types/fs-extra": "^11.0.4",
    "@types/lunr": "^2.3.7",
    "@types/marked": "^6.0.0",
    "typescript": "^5.8.3",
    "semantic-release": "^24.0.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.0",
    "@semantic-release/npm": "^12.0.1"
  }
}
